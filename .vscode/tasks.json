{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Language apps: Check English",
      "type": "process",
      "command": "bun",
      "args": ["run", "check"],
      "options": { "cwd": "${workspaceFolder}/Apps/English/English-Automaticity" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Language apps: Verify German",
      "type": "process",
      "command": "bun",
      "args": ["run", "verify"],
      "options": { "cwd": "${workspaceFolder}/Apps/Deutsch-Automaticity" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Language apps: Test Python research",
      "type": "process",
      "command": "${workspaceFolder}/research/cefr-classification/.venv/Scripts/python.exe",
      "args": ["-m", "unittest", "discover", "-v", "-s", "tests", "-t", "tests", "-p", "test_*.py"],
      "options": { "cwd": "${workspaceFolder}/research/cefr-classification", "env": { "PYTHONDONTWRITEBYTECODE": "1" } },
      "group": "test",
      "problemMatcher": []
    }
  ]
}

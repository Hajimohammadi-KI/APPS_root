{
  "name": "research-pdf-studio",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bun install --frozen-lockfile",
    "prepare:pdf-worker": "node scripts/prepare-pdf-worker.mjs",
    "dev": "bun run prepare:pdf-worker && vite",
    "build": "bun run prepare:pdf-worker && vinext build",
    "start": "wrangler dev dist/server/index.js --config dist/server/wrangler.json --persist-to .wrangler/state --ip 127.0.0.1 --port 4332",
    "start:local": "node scripts/start-local.mjs",
    "test": "bun run build && bun test tests/pdf-marks.test.ts tests/pdf-reader-state.test.ts tests/provider-integration.test.ts tests/document-converters.test.ts && node --test tests/rendered-html.test.mjs tests/windows-release.test.mjs",
    "test:runtime": "node --test tests/local-runtime.test.mjs",
    "test:e2e": "playwright test",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "typecheck": "node node_modules/typescript7/lib/tsc.js --noEmit --incremental false",
    "check:duplicates": "node ../../../shared/check-duplicated-files.mjs",
    "lint": "node ../../../shared/check-duplicated-files.mjs && eslint \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"db/**/*.ts\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,mjs,ts}\" \"*.{ts,tsx,js,mjs}\" --no-error-on-unmatched-pattern",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "package:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-release.ps1"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bun": "^1.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript7": "npm:typescript@7.0.2",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Research PDF Studio",
  "overrides": {
    "undici": "7.24.7"
  }
}

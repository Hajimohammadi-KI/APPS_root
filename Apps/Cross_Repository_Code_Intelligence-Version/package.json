{
  "name": "cross-repository-study-tracker",
  "version": "0.5.0-version2",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:ci": "bun install --frozen-lockfile",
    "local": "node scripts/generate-local-env.mjs && bun run dev:all",
    "prepare:pdf-worker": "node scripts/prepare-pdf-worker.mjs",
    "dev": "bun run prepare:pdf-worker && vite",
    "dev:web": "bun run prepare:pdf-worker && vite",
    "dev:vercel": "bun run prepare:pdf-worker && next dev",
    "dev:api": "bun run --cwd apps/api start:dev",
    "dev:all": "bun run --parallel dev:web dev:api",
    "build": "bun run prepare:pdf-worker && vinext build",
    "build:vercel": "bun run prepare:pdf-worker && next build",
    "build:api": "bun run --cwd apps/api build",
    "build:all": "bun run build && bun run build:api",
    "start": "wrangler dev dist/server/index.js --config dist/server/wrangler.json --persist-to .wrangler/state --port 4312 --ip 127.0.0.1 --log-level warn",
    "start:web": "vinext start --hostname 127.0.0.1 --port 4312",
    "start:vercel": "next start",
    "start:api": "bun run --cwd apps/api start",
    "test": "bun run build && bun test tests/*.test.ts && node --test tests/*.test.mjs",
    "validate:artifact": "node --input-type=module -e \"import('./dist/server/index.js').then(m=>{if(typeof m.default?.fetch!=='function')process.exit(1)})\"",
    "verify:vercel": "node scripts/verify-vercel.mjs",
    "check:duplicates": "node ../../shared/check-duplicated-files.mjs",
    "lint": "node ../../shared/check-duplicated-files.mjs && eslint app components db lib packages tests --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "node node_modules/typescript7/lib/tsc.js --noEmit --incremental false && bun run --cwd apps/api typecheck",
    "db:generate": "drizzle-kit generate",
    "audit:legacy": "bun scripts/legacy-migration-audit.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "bun": "^1.3.14",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright-core": "1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript7": "npm:typescript@7.0.2",
    "vercel": "58.7.1",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Cross Repository Code Intelligence Study Tracker – Version2"
}

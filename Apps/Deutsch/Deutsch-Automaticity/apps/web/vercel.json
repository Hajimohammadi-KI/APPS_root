{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "NODE_PATH=$PWD/node_modules bun run build",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "framework": "nextjs",
  "bunVersion": "1.x",
  "env": {
    "VERCEL_PREVIEW_FEEDBACK_ENABLED": "0",
    "NEXT_PUBLIC_PDF_READER_URL": "https://research-pdf-studio.vercel.app/"
  }
}

{
  "name": "german-grammar-automaticity",
  "version": "10.8.2026",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors magenta,cyan \"bun run --cwd apps/api dev\" \"bun run --cwd apps/web dev -- --hostname 127.0.0.1 --port 3210\"",
    "start": "concurrently --kill-others-on-fail --names api,web --prefix-colors magenta,cyan \"bun run --cwd apps/api start\" \"bun run --cwd apps/web start -- --hostname 127.0.0.1 --port 3210\"",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "content:extract": "bun scripts/extract-legacy-catalog.ts",
    "extract:legacy": "bun scripts/extract-legacy-content.ts",
    "db:schema:check": "bun test scripts/supabase-schema.test.ts",
    "legacy:serve": "bun scripts/serve-legacy.ts",
    "build": "bun run --filter '*' --if-present build",
    "db:seed:generate": "bun scripts/generate-supabase-seed.ts",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check .",
    "lint": "bun run --filter '*' --if-present lint",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "automaticity:check": "bun test packages/learning-core/src/automaticity packages/learning-core/src/index.test.ts && bun run --cwd packages/learning-core typecheck",
    "test": "bun run --filter '*' --if-present test",
    "test:integration": "bun run --filter '*' --if-present test:integration",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:installer": "bun test scripts/windows-installer.test.ts",
    "parity:check": "bun scripts/check-english-german-parity.ts",
    "parity:check:strict": "bun scripts/check-english-german-parity.ts --strict",
    "package:stores": "bun scripts/package-stores.ts all",
    "package:android": "bun scripts/package-stores.ts android",
    "package:windows": "bun scripts/package-stores.ts windows",
    "package:ios": "bun scripts/package-stores.ts ios",
    "package:windows-exe": "bun scripts/package-windows-installer.ts",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:installer && bun run db:schema:check && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "concurrently": "10.0.4",
    "next": "16.2.12",
    "prettier": "^3.8.2",
    "typescript": "7.0.2"
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "mkdir -p public && cp -R apps/web/public/. public/ && NODE_PATH=$PWD/apps/web/node_modules bun run --cwd apps/web build",
  "ignoreCommand": null,
  "bunVersion": "1.x",
  "env": {
    "VERCEL_PREVIEW_FEEDBACK_ENABLED": "0",
    "NEXT_PUBLIC_PDF_READER_URL": "https://research-pdf-studio.vercel.app/"
  }
}

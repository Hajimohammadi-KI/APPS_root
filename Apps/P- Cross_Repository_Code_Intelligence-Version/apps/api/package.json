{
  "name": "@cross-repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "bun --watch src/main.ts",
    "build": "node -e \"const fs=require('node:fs'); for (const path of ['dist','tsconfig.tsbuildinfo']) fs.rmSync(path,{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cross-repo/contracts": "file:../../packages/contracts",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@types/node": "22.19.19",
    "typescript": "7.0.2"
  }
}

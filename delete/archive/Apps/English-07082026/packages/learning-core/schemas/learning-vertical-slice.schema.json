{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automaticity.local/schemas/learning-vertical-slice-1.0.0.json",
  "title": "Automaticity learning vertical slice",
  "type": "object",
  "required": ["contentUnit", "dailyPlan", "response", "evidence", "events"],
  "properties": {
    "contentUnit": { "$ref": "#/$defs/contentUnit" },
    "dailyPlan": { "$ref": "#/$defs/dailyPlan" },
    "response": { "$ref": "#/$defs/learnerResponse" },
    "evidence": { "$ref": "#/$defs/evidenceRecord" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/domainEvent" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "schemaVersion": { "const": "1.0.0" },
    "language": { "enum": ["en", "de"] },
    "mode": {
      "enum": [
        "recognition",
        "recall",
        "writing",
        "speaking",
        "repair",
        "transfer",
        "mediation"
      ]
    },
    "contentUnit": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "version",
        "language",
        "title",
        "targetForm",
        "prompt",
        "modes",
        "provenance"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "language": { "$ref": "#/$defs/language" },
        "cefrLevel": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "title": { "type": "string", "minLength": 1 },
        "targetForm": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mode" }
        },
        "provenance": {
          "type": "object",
          "required": ["kind", "sourceId", "license", "humanReviewed"],
          "properties": {
            "kind": { "enum": ["authored", "open-dataset"] },
            "sourceId": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "humanReviewed": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dailyPlan": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "createdAt",
        "language",
        "sessionMinutes",
        "contentUnitId",
        "program"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "language": { "$ref": "#/$defs/language" },
        "sessionMinutes": { "enum": [15, 30, 45] },
        "contentUnitId": { "type": "string" },
        "program": { "type": "object" }
      },
      "additionalProperties": false
    },
    "learnerResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "contentUnitId",
        "dailyPlanId",
        "mode",
        "submittedAt",
        "inputText",
        "correctedText",
        "latencyMs",
        "audio"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "type": "string" },
        "contentUnitId": { "type": "string" },
        "dailyPlanId": { "type": "string" },
        "mode": { "$ref": "#/$defs/mode" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "inputText": { "type": "string" },
        "correctedText": { "type": "string" },
        "latencyMs": { "type": ["integer", "null"], "minimum": 0 },
        "audio": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "evidenceRecord": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "responseId",
        "contentUnitId",
        "createdAt",
        "mode",
        "verification",
        "metrics",
        "gates",
        "masteryEligible",
        "automaticityClaim"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "type": "string" },
        "responseId": { "type": "string" },
        "contentUnitId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "mode": { "$ref": "#/$defs/mode" },
        "verification": { "type": "object" },
        "metrics": { "type": "object" },
        "gates": { "type": "object" },
        "masteryEligible": { "type": "boolean" },
        "automaticityClaim": { "const": "insufficient-longitudinal-evidence" }
      },
      "additionalProperties": false
    },
    "domainEvent": {
      "type": "object",
      "required": ["schemaVersion", "id", "type", "occurredAt", "payload"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "type": "string" },
        "type": {
          "enum": [
            "learning.response.submitted.v1",
            "learning.evidence.recorded.v1",
            "learning.evidence.invalidated.v1",
            "learning.delayed-recall.recorded.v1",
            "learning.novel-transfer.recorded.v1"
          ]
        },
        "occurredAt": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
